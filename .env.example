# ResearchPrepAI Environment Variables

# Application Secret Key
SECRET_KEY=researchprepai-secret-production-key-change-me-32bytes

# Database Configuration
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/researchprep

# Redis / Celery Broker
REDIS_URL=redis://localhost:6379/0

# Razorpay Integration (Test Mode)
RAZORPAY_KEY_ID=rzp_test_samplekey123
RAZORPAY_KEY_SECRET=rzp_test_samplesecret123
RAZORPAY_WEBHOOK_SECRET=whsec_sample123

# File Storage
STORAGE_DIR=./uploads
S3_ENDPOINT_URL=
S3_BUCKET_NAME=researchprepai-storage

# OAuth Placeholders
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
APPLE_CLIENT_ID=com.researchprepai.auth.client
